rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      // MASTER ADMIN UID: nWh4SGrdQYZs8wlTg1PqpXoQnB73
      return isSignedIn() && request.auth.uid == 'nWh4SGrdQYZs8wlTg1PqpXoQnB73';
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION GROUP RULES ---
    // These are critical for collectionGroup('orders') queries used in Admin Dashboard
    match /{path=**}/orders/{orderId} {
      allow list, get: if isSuperAdmin();
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid);
      allow update: if isSuperAdmin();
    }

    // --- COLLECTION RULES ---

    // CUSTOMERS collection
    match /customers/{userId} {
      allow get, list, update: if isSuperAdmin() || isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      match /cart/{docId} { allow read, write: if isOwner(userId); }
      match /favorites/{docId} { allow read, write: if isOwner(userId); }
      match /nutrition/{docId} { allow read, write: if isOwner(userId); }

      match /orders/{orderId} {
        allow create: if isOwner(userId);
        allow get, list, update, delete: if isOwner(userId) || isSuperAdmin();
      }
    }
    
    // DISHES collection
    match /dishes/{dishId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    
    // TESTIMONIALS collection
    match /testimonials/{testimonialId} {
        allow read: if true;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
        allow delete: if isSuperAdmin();
    }

    // CONTACT-SUBMISSIONS collection
    match /contact-submissions/{submissionId} {
      allow create: if true;
      allow list, get, delete: if isSuperAdmin();
    }
  }
}